{
  "name": "screensnap",
  "version": "1.1.0",
  "description": "Record the screen and take screenshots of connected Android and iOS devices",
  "author": "Andrii Serheniuk",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5173 && DSR_DEV=1 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac --dir",
    "pack": "npm run build && electron-builder --mac",
    "icon": "electron scripts/make-icon.cjs && bash scripts/make-icns.sh"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.andrii.screensnap",
    "productName": "ScreenSnap",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Required to read the screen of a connected iPhone or iPad over USB. No camera is ever recorded and no audio is captured.",
        "NSMicrophoneUsageDescription": null
      },
      "icon": "build/icon.icns"
    },
    "artifactName": "${productName}-${version}.${ext}",
    "dmg": {
      "title": "ScreenSnap"
    }
  }
}
